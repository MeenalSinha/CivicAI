# ============================================================
# CivicAI Backend Configuration
# Copy to .env and fill in your values:  cp .env.example .env
# ============================================================

# ---- HuggingFace (REQUIRED) ----
# Get your token at: https://huggingface.co/settings/tokens
# Must accept Mistral-7B license at: https://huggingface.co/mistralai/Mistral-7B-Instruct-v0.3
HF_TOKEN=hf_your_token_here

# ---- AI Models ----
MISTRAL_MODEL_ID=mistralai/Mistral-7B-Instruct-v0.3
LORA_ADAPTER_PATH=
WHISPER_MODEL_SIZE=base
YOLO_MODEL_PATH=yolov8n.pt
PRELOAD_YOLO=false
PRELOAD_WHISPER=false

# ---- AI Service Connection ----
# Docker: http://ai-service:8000 | Local dev: http://localhost:8000
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT=30000

# ---- Anthropic Fallback (OPTIONAL) ----
# Leave blank to run fully open-source (Mistral + rule-based fallback)
ANTHROPIC_API_KEY=

# ---- JWT Security (REQUIRED) ----
# CHANGE THIS — generate with:  openssl rand -hex 64
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX
JWT_EXPIRES=8h

# ---- Officer Accounts ----
# Password set when officer accounts are first created in DB
# Change after first login
DEFAULT_OFFICER_PASSWORD=CivicAI@2024

# ---- Server ----
PORT=3001
NODE_ENV=development

# ---- Database ----
DB_PATH=./civicai.db

# ---- CORS ----
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000

# ---- Map Coordinates ----
# Default city center for approximate complaint location pinning
# Delhi: 28.6139, 77.2090 | Bengaluru: 12.9716, 77.5946 | Mumbai: 19.0760, 72.8777
DEFAULT_LAT=28.6139
DEFAULT_LNG=77.2090
# Jitter radius in degrees (~0.06 = ~3km spread)
COORD_SPREAD=0.06

# ---- Frontend Build (used by docker-compose build args) ----
REACT_APP_API_URL=http://localhost:3001/api
REACT_APP_WS_URL=ws://localhost:3001
